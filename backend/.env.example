PORT=8080

# MongoDB Atlas connection string
MONGO_URI=

# The frontend's URL (used for CORS + password-reset email links).
# Local dev: http://localhost:5173
# Deployed: your frontend's real URL, e.g. https://homelyhub.vercel.app
ORIGIN_ACCESS_URL=http://localhost:5173

# Pexels API key (pexels.com/api) — used for property images
PEXELS_API_KEY=

# Mailtrap SMTP (mailtrap.io) — used for password-reset emails
MAILTRAP_SMTP_HOST=
MAILTRAP_SMTP_PORT=
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=

# ImageKit (imagekit.io) — used for property/avatar image uploads
IMAGEKIT_PUBLICKEY=
IMAGEKIT_PRIVATEKEY=
IMAGEKIT_URLENDPOINT=

# JWT auth
JWT_SECRET=
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Groq API key (console.groq.com) — used for AI trip planner / descriptions
GROQ_API_KEY=
